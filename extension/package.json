    "configuration": {
      "title": "Steerhouse",
      "properties": {
        "steerhouse.days": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "%setting.show.sessions.active.in.the.last.n.days%"
        },
        "steerhouse.pollSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "%setting.how.often.to.look.for.session.updates%"
        },
        "steerhouse.agentCommand": {
          "type": "string",
          "default": "claude",
          "description": "%setting.agent.cli.used.to.start.resume.and.run.prompts%"
        },
        "steerhouse.agentArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%setting.extra.arguments.for.every.agent.run.e.g.model.opus%"
        },
        "steerhouse.browser": {
          "type": "string",
          "enum": [
            "default",
            "chrome",
            "edge",
            "firefox",
            "custom"
          ],
          "enumDescriptions": [
            "%setting.browser.default%",
            "Google Chrome",
            "Microsoft Edge",
            "Mozilla Firefox",
            "%setting.browser.custom%"
          ],
          "default": "default",
          "description": "%setting.browser%"
        },
        "steerhouse.browserPath": {
          "type": "string",
          "default": "",
          "description": "%setting.browserPath%"
        },
        "steerhouse.defaultSurface": {
          "type": "string",
          "enum": [
            "chat",
            "terminal"
          ],
          "default": "chat",
          "description": "%setting.where.new.and.resumed.sessions.open.the.steerhouse.chat.or.a.%"
        },
        "steerhouse.codeCompletion.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%setting.code.completion.enabled%"
        },
        "steerhouse.codeCompletion.provider": {
          "type": "string",
          "default": "",
          "description": "%setting.code.completion.provider%"
        },
        "steerhouse.codeCompletion.model": {
          "type": "string",
          "default": "",
          "description": "%setting.code.completion.model%"
        },
        "steerhouse.codeCompletion.delayMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "description": "%setting.code.completion.delay%"
        },
        "steerhouse.keepChatsRunning": {
          "type": "boolean",
          "default": true,
          "description": "%setting.keep.chats.running%"
        },
        "steerhouse.tabCompletion": {
          "type": "boolean",
          "default": true,
          "description": "%setting.tab.completion%"
        },
        "steerhouse.pwview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%setting.pwview.enabled%"
        },
        "steerhouse.pwview.path": {
          "type": "string",
          "default": "",
          "description": "%setting.pwview.path%"
        },
        "steerhouse.hideTempSessions": {
          "type": "boolean",
          "default": true,
          "description": "%setting.hide.sessions.that.ran.inside.the.system.temp.folder.scratch%"
        },
        "steerhouse.notifications": {
          "type": "boolean",
          "default": true,
          "description": "%setting.notifications%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "steerhouse.prompts",
        "contents": "Prompts are reusable instructions you can run in one click, interactive or headless (claude -p), with ${file}, ${selection} and ${input:…} variables.\n[Add Starter Prompts](command:steerhouse.starterPrompts)\n[New Prompt](command:steerhouse.newPrompt)\nProject prompts live in .steerhouse/prompts/ (commit them to share with the team)."
      },
      {
        "view": "steerhouse.skills",
        "contents": "Skills teach agents how to do things in your project. One SKILL.md works in Claude Code, Cursor, Codex, Gemini CLI, Copilot and more. Each agent just looks in a different folder.\n[Add Skill from skills.sh](command:steerhouse.skillAdd)\n[New Skill](command:steerhouse.newSkill)"
      }
    ],
    "keybindings": [
      {
        "command": "steerhouse.pasteImage",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "terminalFocus"
      },
      {
        "command": "steerhouse.deleteSession",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == steerhouse.sessions && listHasSelectionOrFocus"
      },
      {
        "command": "steerhouse.fs.rename",
        "key": "f2",
        "when": "focusedView == steerhouse.sessions && viewItem =~ /^fs(file|folder)$/"
      }
    ],
    "walkthroughs": [
      {
        "id": "steerhouse.start",
        "title": "%walk.get.started.with.steerhouse%",
        "description": "%walk.two.minutes.claude.code.login.message.delivery.your.first.ch%",
        "steps": [
          {
            "id": "claude",
            "title": "%step.check.claude.code%",
            "description": "%step.steerhouse.drives.your.own.claude.code.and.its.login.check.se%",
            "media": {
              "markdown": "media/walkthrough/1-claude.md"
            },
            "completionEvents": [
              "onContext:steerhouse.claudeOk"
            ]
          },
          {
            "id": "login",
            "title": "%step.log.in.once%",
            "description": "%step.one.login.is.reused.by.every.chat.and.terminal.log.in%",
            "media": {
              "markdown": "media/walkthrough/2-login.md"
            },
            "completionEvents": [
              "onContext:steerhouse.loginOk"
            ]
          },
          {
            "id": "hooks",
            "title": "%step.enable.messages.to.terminal.agents%",
            "description": "%step.queue.steer.send.now.for.sessions.running.in.a.terminal.enab%",
            "media": {
              "markdown": "media/walkthrough/3-hooks.md"
            },
            "completionEvents": [
              "onContext:steerhouse.hooksOk"
            ]
          },
          {
            "id": "chat",
            "title": "%step.start.your.first.chat%",
            "description": "%step.claude.code.with.a.real.ui.plan.live.status.diffs.images.new%",
            "media": {
              "markdown": "media/walkthrough/4-chat.md"
            },
            "completionEvents": [
              "onContext:steerhouse.chatStarted"
            ]
          },
          {
            "id": "dashboard",
            "title": "%step.see.every.session.diff.and.link%",
            "description": "%step.sessions.sub.agents.changes.and.the.graph.open.dashboard%",
            "media": {
              "markdown": "media/walkthrough/5-dashboard.md"
            },
            "completionEvents": [
              "onCommand:steerhouse.dashboard"
            ]
          },
          {
            "id": "skills",
            "title": "%step.skills.for.every.agent%",
            "description": "%step.one.skill.visible.to.claude.code.cursor.codex.and.more.add.a%",
            "media": {
              "markdown": "media/walkthrough/6-skills.md"
            },
            "completionEvents": [
              "onCommand:steerhouse.skillAdd",
              "onView:steerhouse.skills"
            ]
          },
          {
            "id": "browser",
            "title": "%step.watch.browser%",
            "description": "%step.watch.browser.description%",
            "media": {
              "markdown": "media/walkthrough/7-browser.md"
            },
            "completionEvents": [
              "onCommand:steerhouse.pwview.open"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "esbuild src/extension.ts src/hook.ts src/relay.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --define:import.meta.url=importMetaUrl --inject:build/import-meta-url.js --external:bufferutil --external:utf-8-validate --outdir=dist",
    "build:webview": "vite build --config webview/vite.config.mts",
    "dev:webview": "vite --config webview/vite.config.mts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test": "node --test test/uploads.test.cjs test/relay.test.cjs test/codeCompletion.test.cjs test/shell.test.cjs test/pwview.test.cjs test/engine.test.cjs test/unit.test.cjs test/markdown.test.cjs test/i18n-accounts.test.cjs test/chat-ui.test.cjs test/usage.test.cjs test/providers.test.cjs test/limits.test.cjs test/prs.test.cjs test/mcp.test.cjs test/worktree.test.cjs test/remote.test.cjs test/migrate.test.cjs test/bgtasks.test.cjs test/scm.test.cjs",
    "test:e2e": "node --test test/e2e-relay.test.cjs test/e2e.test.cjs test/e2e-steer.test.cjs test/e2e-context.test.cjs test/e2e-mcp.test.cjs test/e2e-fork.test.cjs test/e2e-bg.test.cjs",
    "package": "vsce package --no-dependencies",
    "test:editor": "npm run build && node test/editor/run.cjs",
    "test:restore": "npm run build && node test/editor/restore.cjs",
    "test:usage": "npm run build && xvfb-run -a -s '-screen 0 1400x900x24' node test/editor/usage.cjs",
    "test:usage:agent": "npm run build && USAGE_SCENARIO=$PWD/test/editor/usage-agent.cjs xvfb-run -a -s '-screen 0 1400x900x24' node test/editor/usage.cjs",
    "vscode:prepublish": "npm run build"
  },
