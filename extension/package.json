        {
          "command": "steerhouse.fs.newFile",
          "when": "view == steerhouse.sessions && viewItem == fsfolder",
          "group": "1_new@1"
        },
        {
          "command": "steerhouse.fs.newFolder",
          "when": "view == steerhouse.sessions && viewItem == fsfolder",
          "group": "1_new@2"
        },
        {
          "command": "steerhouse.fs.findInFolder",
          "when": "view == steerhouse.sessions && viewItem == fsfolder",
          "group": "4_search@1"
        },
        {
          "command": "steerhouse.fs.selectForCompare",
          "when": "view == steerhouse.sessions && viewItem == fsfile",
          "group": "3_compare@1"
        },
        {
          "command": "steerhouse.fs.compareWithSelected",
          "when": "view == steerhouse.sessions && viewItem == fsfile && steerhouse.compareSelected",
          "group": "3_compare@2"
        },
        {
          "command": "steerhouse.fs.copyPath",
          "when": "view == steerhouse.sessions && viewItem =~ /^fs(file|folder)$/",
          "group": "6_copypath@1"
        },
        {
          "command": "steerhouse.fs.copyRelativePath",
          "when": "view == steerhouse.sessions && viewItem =~ /^fs(file|folder)$/",
          "group": "6_copypath@2"
        },
        {
          "command": "steerhouse.fs.rename",
          "when": "view == steerhouse.sessions && viewItem =~ /^fs(file|folder)$/",
          "group": "7_modification@1"
        },
        {
          "command": "steerhouse.fs.delete",
          "when": "view == steerhouse.sessions && viewItem =~ /^fs(file|folder)$/",
          "group": "7_modification@2"
        },
        {
          "command": "steerhouse.openTerminalHere",
          "when": "view == steerhouse.sessions && viewItem =~ /^fs(file|folder)$/",
          "group": "navigation@4"
        },
        {
          "command": "steerhouse.newChatHere",
          "when": "view == steerhouse.sessions && viewItem == fsfolder",
          "group": "steerhouse@1"
        },
        {
          "command": "steerhouse.newChatInWorktree",
          "when": "view == steerhouse.sessions && viewItem == fsfolder",
          "group": "steerhouse@2"
        },
        {
          "command": "steerhouse.scm.commit",
          "when": "view == steerhouse.sessions && viewItem =~ /^scm dirty/",
          "group": "inline@1"
        },
        {
          "command": "steerhouse.scm.sync",
          "when": "view == steerhouse.sessions && viewItem =~ /^scm .*\\btracked\\b/",
          "group": "inline@2"
        },
        {
          "command": "steerhouse.scm.push",
          "when": "view == steerhouse.sessions && viewItem =~ /^scm\\b/",
          "group": "1_sync@1"
        },
        {
          "command": "steerhouse.scm.pull",
          "when": "view == steerhouse.sessions && viewItem =~ /^scm .*\\btracked\\b/",
          "group": "1_sync@2"
        },
        {
          "command": "steerhouse.scm.openView",
          "when": "view == steerhouse.sessions && viewItem =~ /^scm\\b/",
          "group": "inline@3"
        },
        {
          "command": "steerhouse.scm.openFile",
          "when": "view == steerhouse.sessions && viewItem == scmfile",
          "group": "inline@1"
        },
        {
          "command": "steerhouse.scm.commit",
          "when": "view == steerhouse.sessions && viewItem =~ /^scm dirty/",
          "group": "0_commit@1"
        },
        {
          "command": "steerhouse.scm.sync",
          "when": "view == steerhouse.sessions && viewItem =~ /^scm .*\\btracked\\b/",
          "group": "1_sync@0"
        },
        {
          "command": "steerhouse.scm.openView",
          "when": "view == steerhouse.sessions && viewItem =~ /^scm\\b/",
          "group": "2_view@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "steerhouse.addToChat",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "steerhouse@0"
        }
      ],
      "comments/commentThread/context": [
        {
